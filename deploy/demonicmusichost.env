# ── Demonic Music Host – Backend Environment Variables ───────────────────────
# Copy this file to /opt/demonicmusichost/demonicmusichost.env on the server
# and fill in all values marked with <REPLACE_ME>.
#
# IMPORTANT: chmod 600 /opt/demonicmusichost/demonicmusichost.env
#            chown demonicmusichost:demonicmusichost /opt/demonicmusichost/demonicmusichost.env

# ── Server ────────────────────────────────────────────────────────────────────

# Port the Ktor server listens on (nginx proxies to this)
PORT=8080

# Public base URL of your server (used for Spotify OAuth redirect_uri)
# Example: https://music.example.com
BASE_URL=https://<YOUR_DOMAIN>

# ── Spotify OAuth ─────────────────────────────────────────────────────────────

# From https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=<REPLACE_ME>
SPOTIFY_CLIENT_SECRET=<REPLACE_ME>

# Must match exactly what is registered in the Spotify dashboard
# Typically: ${BASE_URL}/auth/callback
SPOTIFY_REDIRECT_URI=https://<YOUR_DOMAIN>/auth/callback

# ── YouTube Data API v3 ───────────────────────────────────────────────────────

# From https://console.cloud.google.com → "YouTube Data API v3"
YOUTUBE_API_KEY=<REPLACE_ME>

# ── Session Security ──────────────────────────────────────────────────────────

# Random secret used for HMAC-signing the session cookie.
# Generate with: openssl rand -hex 32
SESSION_SECRET=<REPLACE_ME>

# ── JVM Tuning (override defaults in the .service file if needed) ─────────────
# These are already set in the systemd ExecStart; override here if desired.
# JAVA_OPTS=-Xms256m -Xmx1g
