<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Main App Theme -->
    <style name="Theme.DemonicMusicHost" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Background -->
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="android:colorBackground">@color/background_dark</item>
        <item name="colorSurface">@color/surface_dark</item>

        <!-- Primary = Spotify Green -->
        <item name="colorPrimary">@color/spotify_green</item>
        <item name="colorPrimaryVariant">@color/spotify_green_dark</item>
        <item name="colorOnPrimary">@color/background_dark</item>

        <!-- Secondary = Discord Blurple -->
        <item name="colorSecondary">@color/discord_blurple</item>
        <item name="colorSecondaryVariant">@color/discord_blurple_dark</item>
        <item name="colorOnSecondary">@color/text_primary</item>

        <!-- Error -->
        <item name="colorError">@color/error_color</item>
        <item name="colorOnError">@color/text_primary</item>

        <!-- Text -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnBackground">@color/text_primary</item>

        <!-- Status Bar (Discord dark) -->
        <item name="android:statusBarColor">@color/background_elevated</item>
        <item name="android:navigationBarColor">@color/background_dark</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Shape -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.DemonicMusicHost.SmallComponent</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.DemonicMusicHost.MediumComponent</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.DemonicMusicHost.LargeComponent</item>

        <!-- Bottom Sheet -->
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.DemonicMusicHost.BottomSheet</item>
    </style>

    <!-- Splash Screen theme (shows background before main renders) -->
    <style name="Theme.DemonicMusicHost.Splash" parent="Theme.DemonicMusicHost">
        <item name="android:windowSplashScreenBackground">@color/background_dark</item>
    </style>

    <!-- Shape Appearances -->
    <style name="ShapeAppearance.DemonicMusicHost.SmallComponent" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <style name="ShapeAppearance.DemonicMusicHost.MediumComponent" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.DemonicMusicHost.LargeComponent" parent="ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <!-- Bottom Sheet -->
    <style name="ThemeOverlay.DemonicMusicHost.BottomSheet" parent="ThemeOverlay.MaterialComponents.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.DemonicMusicHost.BottomSheet</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>

    <style name="Widget.DemonicMusicHost.BottomSheet" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="backgroundTint">@color/surface_dark</item>
        <item name="shapeAppearance">@style/ShapeAppearance.DemonicMusicHost.LargeComponent</item>
    </style>

    <!-- Text Appearances -->
    <style name="TextAppearance.DemonicMusicHost.Headline" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-black</item>
    </style>

    <style name="TextAppearance.DemonicMusicHost.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- Chip Style -->
    <style name="Widget.DemonicMusicHost.Chip" parent="Widget.MaterialComponents.Chip.Action">
        <item name="chipBackgroundColor">@color/card_dark</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipStrokeColor">@color/divider</item>
    </style>

</resources>
