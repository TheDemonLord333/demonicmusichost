<?xml version="1.0" encoding="utf-8"?>
<!--
    Font files must be placed in this directory.
    Recommended: Download from Google Fonts
    - Inter-Regular.ttf  → rename to regular.ttf
    - Inter-Medium.ttf   → rename to medium.ttf
    - Inter-Bold.ttf     → rename to bold.ttf

    Or use system fonts by referencing them via android:fontFamily:
    - "sans-serif"         (Roboto Regular)
    - "sans-serif-medium"  (Roboto Medium)
    - "sans-serif-black"   (Roboto Black)
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font
        android:fontStyle="normal"
        android:fontWeight="400"
        android:font="@font/regular" />
    <font
        android:fontStyle="normal"
        android:fontWeight="500"
        android:font="@font/medium" />
    <font
        android:fontStyle="normal"
        android:fontWeight="700"
        android:font="@font/bold" />
</font-family>
